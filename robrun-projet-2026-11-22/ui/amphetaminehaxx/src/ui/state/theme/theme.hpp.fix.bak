#pragma once
#include "ui/types/ui-theme/ui-theme.hpp"
#include "imgui.h"

namespace ui
{
    extern ImVec2 InnerSize;
    extern float GroupWidth;
    constexpr float ContentLeft = 52.0f;
    constexpr float ContentTop = 57.0f;
    extern UiTheme theme;
    inline auto& background_color = theme.background_color;
    inline auto& group_color = theme.group_color;
    inline auto& border_color = theme.border_color;
    inline auto& text_color = theme.text_color;
    inline auto& control_color = theme.control_color;
    inline auto& track_color = theme.track_color;
    inline auto& checkbox_outline_color = theme.checkbox_outline_color;
    inline auto& checkbox_off_color = theme.checkbox_off_color;
    inline auto& checkbox_on_color = theme.checkbox_on_color;
    inline auto& checkbox_on_shade_color = theme.checkbox_on_shade_color;
    inline auto& checkbox_text_color = theme.checkbox_text_color;
    inline auto& slider_border_color = theme.slider_border_color;
    inline auto& slider_track_bottom_color = theme.slider_track_bottom_color;
    inline auto& slider_fill_shade_color = theme.slider_fill_shade_color;
    inline auto& slider_label_color = theme.slider_label_color;
    inline auto& slider_value_color = theme.slider_value_color;
    inline auto& slider_button_text_color = theme.slider_button_text_color;
    inline auto& control_border_color = theme.control_border_color;
    inline auto& control_text_color = theme.control_text_color;
    inline auto& control_arrow_color = theme.control_arrow_color;
    inline auto& button_text_color = theme.button_text_color;
    inline auto& group_black_line_color = theme.group_black_line_color;
    inline auto& tab_text_color = theme.tab_text_color;
    inline auto& tab_idle_line_color = theme.tab_idle_line_color;
    inline auto& tab_idle_line_bottom_color = theme.tab_idle_line_bottom_color;
    inline auto& tab_line_shadow_color = theme.tab_line_shadow_color;
    inline auto& tab_line_black_color = theme.tab_line_black_color;
    inline auto& outer_shadow_color = theme.outer_shadow_color;
    inline auto& outer_outer_line_color = theme.outer_outer_line_color;
    inline auto& outer_between_color = theme.outer_between_color;
    inline auto& outer_inner_line_color = theme.outer_inner_line_color;
    inline auto& outer_face_color = theme.outer_face_color;
    inline auto& panel_outer_line_color = theme.panel_outer_line_color;
    inline auto& panel_between_color = theme.panel_between_color;
    inline auto& panel_inner_line_color = theme.panel_inner_line_color;
    inline auto& panel_inside_color = theme.panel_inside_color;

    inline auto& text_dim_color = slider_value_color;
    inline auto& accent_color = checkbox_on_color;

    struct ThemePreset
    {
        ImU32 bg, panel, panel_alt, border;
        ImU32 text, text_dim, accent, accent_dim, success, warning;
        float rounding, border_thickness, padding;
    };

    inline ThemePreset graphite()
    {
        return ThemePreset{
            IM_COL32(14, 15, 17, 255),    IM_COL32(20, 22, 25, 255),
            IM_COL32(26, 29, 33, 255),    IM_COL32(40, 44, 50, 255),
            IM_COL32(226, 230, 235, 255), IM_COL32(130, 138, 148, 255),
            IM_COL32(56, 182, 196, 255),  IM_COL32(30, 98, 108, 255),
            IM_COL32(92, 190, 120, 255),  IM_COL32(214, 158, 66, 255),
            4.f, 1.f, 8.f
        };
    }

    inline ThemePreset amber()
    {
        return ThemePreset{
            IM_COL32(16, 14, 12, 255),    IM_COL32(23, 20, 17, 255),
            IM_COL32(30, 26, 22, 255),    IM_COL32(48, 42, 35, 255),
            IM_COL32(235, 228, 218, 255), IM_COL32(150, 138, 122, 255),
            IM_COL32(232, 150, 60, 255),  IM_COL32(120, 74, 28, 255),
            IM_COL32(120, 190, 120, 255), IM_COL32(220, 120, 80, 255),
            6.f, 1.f, 9.f
        };
    }

    inline ThemePreset violet()
    {
        return ThemePreset{
            IM_COL32(13, 12, 18, 255),    IM_COL32(19, 17, 26, 255),
            IM_COL32(25, 22, 34, 255),    IM_COL32(43, 38, 58, 255),
            IM_COL32(228, 224, 238, 255), IM_COL32(140, 132, 158, 255),
            IM_COL32(178, 96, 232, 255),  IM_COL32(88, 46, 120, 255),
            IM_COL32(120, 190, 150, 255), IM_COL32(220, 160, 80, 255),
            3.f, 1.f, 8.f
        };
    }

    inline ThemePreset& active_preset()
    {
        static ThemePreset current = graphite();
        return current;
    }

    inline void apply(const ThemePreset& t)
    {
        active_preset() = t;
        background_color = t.bg;
        group_color = t.panel;
        border_color = t.border;
        text_color = t.text;
        control_color = t.panel_alt;
        track_color = t.panel_alt;
        checkbox_outline_color = t.border;
        checkbox_off_color = t.panel_alt;
        checkbox_on_color = t.accent;
        checkbox_on_shade_color = t.accent_dim;
        checkbox_text_color = t.text;
        slider_border_color = t.border;
        slider_track_bottom_color = t.bg;
        slider_fill_shade_color = t.accent_dim;
        slider_label_color = t.text;
        slider_value_color = t.text_dim;
        slider_button_text_color = t.text;
        control_border_color = t.border;
        control_text_color = t.text;
        control_arrow_color = t.accent;
        button_text_color = t.text;
        group_black_line_color = t.bg;
        tab_text_color = t.text;
        tab_idle_line_color = t.border;
        tab_idle_line_bottom_color = t.panel_alt;
        tab_line_shadow_color = t.bg;
        tab_line_black_color = t.bg;
        outer_shadow_color = t.bg;
        outer_outer_line_color = t.border;
        outer_between_color = t.panel;
        outer_inner_line_color = t.border;
        outer_face_color = t.panel_alt;
        panel_outer_line_color = t.border;
        panel_between_color = t.panel;
        panel_inner_line_color = t.border;
        panel_inside_color = t.bg;
    }

    inline void apply_theme(int id)
    {
        const ThemePreset preset = (id == 1) ? amber()
                                 : (id == 2) ? violet()
                                             : graphite();
        apply(preset);
    }
}
