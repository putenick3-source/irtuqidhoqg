@echo off
setlocal
rem Build the in-process client module: RobRunInternal.dll.
rem Maps into ROB RUN.exe and renders ESP + menu on the game swap chain.
cd /d "%~dp0"

set "VS="
for %%P in (
    "C:\Program Files\Microsoft Visual Studio\18\Community"
    "C:\Program Files\Microsoft Visual Studio\18\Professional"
    "C:\Program Files\Microsoft Visual Studio\2022\Community"
    "C:\Program Files\Microsoft Visual Studio\2022\Professional"
) do if not defined VS if exist "%%~P\VC\Auxiliary\Build\vcvars64.bat" set "VS=%%~P"
if not defined VS (
    echo [ERROR] vcvars64.bat not found - edit the VS detection above.
    exit /b 1
)
call "%VS%\VC\Auxiliary\Build\vcvars64.bat" >nul
if errorlevel 1 ( echo VCVARS_FAIL & exit /b 1 )

if not exist "build" mkdir "build" || goto fail

set "CFLAGS=/I . /nologo /O2 /D_CRT_SECURE_NO_WARNINGS /DRR_INTERNAL /W3 /MT /GS-"
set "CXXFLAGS=/I . /nologo /O2 /D_CRT_SECURE_NO_WARNINGS /DRR_INTERNAL /W3 /MT /EHsc /std:c++20 /Zc:threadSafeInit- /DNOMINMAX"
set "IUP=/I ui\amphetaminehaxx\vendor\imgui /I ui\amphetaminehaxx\vendor\imgui\backends /I ui\amphetaminehaxx\vendor\imgui\misc\freetype /I ui\amphetaminehaxx\src /I build /I ui\amphetaminehaxx\vendor\FreeType\include"

echo [1/7] internal backend
cl %CFLAGS% /c internal\rr_int_mem.c /Fo:build\int_mem.obj || goto fail
cl %CFLAGS% /c internal\rr_int_threads.c /Fo:build\int_threads.obj || goto fail
cl %CXXFLAGS% %IUP% /c internal\rr_int_gpu.cpp /Fo:build\int_gpu.obj || goto fail
cl %CXXFLAGS% %IUP% /c internal\rr_int_main.cpp /Fo:build\int_main.obj || goto fail
rem Generated by tools/make_weapon_icons.py (4-bit alpha atlas of the game's
rem own weapon sprites); regenerate instead of editing.
cl /nologo /O2 /MT /c internal\rr_weapon_icons_data.c /Fo:build\int_wi_icons.obj || goto fail

echo [2/7] game core
cl %CFLAGS% /c game\rr_game.c /Fo:build\int_game.obj || goto fail
cl %CFLAGS% /c game\rr_unity.c /Fo:build\int_unity.obj || goto fail
cl %CFLAGS% /c memory\rr_chain.c /Fo:build\int_chain.obj || goto fail

echo [3/7] features
cl %CFLAGS% /c features\esp\rr_draw.c /Fo:build\int_draw.obj || goto fail
cl %CFLAGS% /c features\aim\rr_aim.c /Fo:build\int_aim.obj || goto fail
cl %CFLAGS% /c features\visibility\rr_los_geom.c /Fo:build\int_los_geom.obj || goto fail
cl %CFLAGS% /c features\visibility\rr_los_capture.c /Fo:build\int_los_capture.obj || goto fail
cl %CFLAGS% /c features\visibility\rr_los_runtime.c /Fo:build\int_los_runtime.obj || goto fail
cl %CFLAGS% /c features\visibility\rr_los.c /Fo:build\int_los.obj || goto fail

echo [4/7] Amphetaminehaxx + ImGui
powershell.exe -NoProfile -ExecutionPolicy Bypass -File ui\amphetaminehaxx\embed-fonts.ps1 || goto fail
cl %CXXFLAGS% %IUP% /utf-8 /c ui\amphetaminehaxx\bridge.cpp ui\amphetaminehaxx\components.cpp ui\amphetaminehaxx\src\ui\eternal\eternal_menu.cpp /Fobuild\ || goto fail
cl %CXXFLAGS% %IUP% /c ui\amphetaminehaxx\vendor\imgui\imgui.cpp ui\amphetaminehaxx\vendor\imgui\imgui_draw.cpp ^
  ui\amphetaminehaxx\vendor\imgui\imgui_tables.cpp ui\amphetaminehaxx\vendor\imgui\imgui_widgets.cpp ^
  ui\amphetaminehaxx\vendor\imgui\backends\imgui_impl_dx11.cpp ui\amphetaminehaxx\vendor\imgui\backends\imgui_impl_win32.cpp ^
  ui\amphetaminehaxx\vendor\imgui\misc\freetype\imgui_freetype.cpp /Fobuild\ || goto fail

echo [5/7] resources

echo [6/7] link
link /nologo /DLL /DEF:internal\rr_int_export.def /MACHINE:X64 /DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF ^
  /PDB:build\RobRunInternal.pdb /MAP:build\RobRunInternal.map /OUT:build\RobRunInternal.dll ^
  build\int_wi_icons.obj ^
  build\int_mem.obj build\int_threads.obj build\int_gpu.obj build\int_main.obj build\int_game.obj build\int_unity.obj ^
  build\int_chain.obj build\int_draw.obj build\int_aim.obj ^
  build\int_los_geom.obj build\int_los_capture.obj build\int_los_runtime.obj build\int_los.obj ^
  build\bridge.obj build\components.obj build\eternal_menu.obj build\imgui.obj build\imgui_draw.obj build\imgui_tables.obj ^
  build\imgui_widgets.obj build\imgui_impl_dx11.obj build\imgui_impl_win32.obj ^
  build\imgui_freetype.obj ^
  kernel32.lib user32.lib gdi32.lib advapi32.lib ole32.lib shell32.lib winmm.lib ^
  d3d11.lib dxgi.lib d2d1.lib dwrite.lib ^
  ui\amphetaminehaxx\vendor\FreeType\freetype.lib || goto fail

echo [7/7] done
echo BUILD_OK  -^>  build\RobRunInternal.dll
exit /b 0

:fail
echo BUILD_FAIL
exit /b 1
